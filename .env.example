# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID (required in production)
APP_SECRET=               # Application secret (used for JWT signing)
CREDENTIAL_ENCRYPTION_KEY= # Optional separate key; APP_SECRET is the fallback encryption key
WEBHOOK_SECRET=           # Secret used by phone automation webhooks such as EasyPaisa MacroDroid/Tasker
BINANCE_API_KEY=          # Binance API key, server-side only
BINANCE_API_SECRET=       # Binance API secret, server-side only
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
PUBLIC_APP_URL=           # Public app URL, e.g. https://yourdomain.com, used for Binance Pay webhooks

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MongoDB connection string (mongodb://... or mongodb+srv://...)
TRUST_PROXY=false         # Set true only when a trusted reverse proxy overwrites client IP headers

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# -- External product catalog -----------------------------------------------
TECHNYSOFT_API_KEY=       # Technysoft API key used server-side for /v1/products
CANBOSO_API_KEY=          # Canboso Telegram Buyer API key used server-side
AKUNDING_API_KEY=         # Akunding reseller API key used server-side
